# Shopify self-setup. Copy these keys into .env (never commit .env).
# Create a custom app in Shopify admin with the redirect URL:
#   http://127.0.0.1:3456/callback
# Publisher scopes: read_products, write_products, read_publications,
# write_publications, read_payment_gateways, read_shopify_payments_accounts,
# read_markets

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_OAUTH_SCOPES=read_products,write_products,read_publications,write_publications,read_payment_gateways,read_shopify_payments_accounts,read_markets
SHOPIFY_API_VERSION=2024-10
SHOPIFY_STOREFRONT_URL=https://www.realworldcerts.com
# Direct deployment origin for the read-only price audit. Public HTTPS only,
# no credentials/query/fragment, and a host distinct from the CDN (www alias
# included). It must serve the same /data/store-prices.json route.
CHECKOUT_PRICE_ORIGIN_URL=
# Optional: full URL for the synthetic quote audit. Defaults to the checkout
# origin plus /acp/v1/price-quote.
CHECKOUT_QUOTE_URL=
# Durable directory shared by every checkout instance so replaying a quote
# cannot create a second order after a restart. Unset keeps attempts in memory.
# The config check and /health write and remove a probe file here, and warn when
# the directory cannot be written or is instance-local (serverless functions and
# memory-backed paths offer no restart protection). Leave unset on Vercel.
CHECKOUT_ATTEMPT_STORE_DIR=
# Optional: milliseconds a checkout waits for a competing creator before it
# answers 409 CHECKOUT_IN_PROGRESS (retryable). Defaults to 10000.
CHECKOUT_ATTEMPT_CLAIM_TIMEOUT_MS=
SHOPIFY_PRIMARY_DOMAIN=www.realworldcerts.com
# Public Storefront API token used only to create the canary cart/checkout.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional: override the course used for the canary (defaults to the first active course).
SHOPIFY_CANARY_COURSE=
# Canary buyer address. Country and currency default to the primary market;
# these fields are required so shipping and tax match a deliverable buyer.
SHOPIFY_CANARY_COUNTRY_CODE=
SHOPIFY_CANARY_ADDRESS1=
SHOPIFY_CANARY_CITY=
SHOPIFY_CANARY_PROVINCE_CODE=
SHOPIFY_CANARY_POSTAL_CODE=
# Optional: owner attestation JSON for an external payout provider (e.g. PayPal).
# Use this when Shopify Payments is not the payout destination.
# The file must be owner-only (chmod 600); integrations may instead inject the
# attestation object from a secrets store as settings.payoutAttestation.
SHOPIFY_PAYOUT_ATTESTATION_FILE=

# Optional: override the currency reported by /shop.json during a mock run.
# SHOPIFY_STORE_CURRENCY=USD
