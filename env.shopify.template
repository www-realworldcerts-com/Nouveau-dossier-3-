# Shopify self-setup. Copy these keys into .env (never commit .env).
# Create a custom app in Shopify admin with the redirect URL:
#   http://127.0.0.1:3456/callback
# Required scopes: read_products, write_products, read_orders

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_OAUTH_SCOPES=read_products,write_products,read_orders
SHOPIFY_API_VERSION=2024-10
SHOPIFY_STOREFRONT_URL=https://www.realworldcerts.com

# Optional: override the currency reported by /shop.json during a mock run.
# SHOPIFY_STORE_CURRENCY=USD
