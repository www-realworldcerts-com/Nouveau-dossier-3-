# Copy to .env and adjust. Never commit the real file.
DATABASE_URL="file:./db/custom.db"

# Optional: vision model used for image uploads (defaults to glm-4v)
# ZAI_VISION_MODEL="glm-4v"

# Optional: local OpenAI-compatible endpoint (for example Strata on localhost).
# When set, chat runs locally. Cloud chat is used only if fallback is enabled.
# JARVIS_LOCAL_BASE_URL="http://127.0.0.1:8080/v1"
# JARVIS_LOCAL_MODEL="qwen3.8-flash-next"
# JARVIS_LOCAL_API_KEY=""
# JARVIS_LOCAL_TIMEOUT_MS="120000"
# JARVIS_ALLOW_CLOUD_FALLBACK="false"
