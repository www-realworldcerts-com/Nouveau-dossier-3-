# Development image for the JARVIS Next.js app (hot reload).
# Built by jarvis-package/docker-compose.dev.yml with the jarvis/ directory as context.
FROM oven/bun:1.3
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bunx prisma generate

EXPOSE 3000
CMD ["sh", "-c", "bunx prisma db push && bun run dev"]
