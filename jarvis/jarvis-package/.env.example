# Copy to .env before `make env` / `docker compose up`.
# Values below are placeholders; never commit the filled file.

JARVIS_ENV=production
JARVIS_PORT=8000
JARVIS_WEB_PORT=3000
JARVIS_WORKERS=4
JARVIS_LOG_LEVEL=info

# Python agent
JWT_SECRET=change-me
ZAI_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=sqlite:///app/data/jarvis.db

# Redis (used by both compose services)
REDIS_PASSWORD=change-me

# Web
NEXT_PUBLIC_JARVIS_API_URL=http://localhost:8000
