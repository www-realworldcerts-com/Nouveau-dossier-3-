{
  "name": "payment-scripts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node ./scripts/auto-restart-loop.js",
    "swarm:tick": "node scripts/swarm-tick.mjs",
    "swarm:tick:check": "node scripts/swarm-tick.mjs --check-only",
